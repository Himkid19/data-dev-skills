# ============================================================
# master-data-modeling skill · 环境变量模板
# 复制为 .env 并填入真实值；.env 不要提交到 git（含 user key）。
# agent 执行知识库 curl 前先 source 本文件（或由 harness 注入）。
#
# 谁来填（详见仓库 docs/install.md「环境变量配置」）：
#   · MD_OPERATOR         —— 你自己填（你的平台账号）
#   · 其余 MySQL / Panel / KS —— 由你的数据平台管理员提供
#   · DDM_*               —— 可不提供：只在“同步词根”时才需要，不影响建模主流程
# 写入方式（值不回显）：
#   python scripts/setup_env.py --skill master-data-modeling --set KEY=VALUE ...
# ============================================================

# ── Panel API（知识库写操作走这里：raw/write / ingest / raw/ls）─────────────
PANEL_BASE_URL=http://REPLACE_ME:8125

# ── 鉴权（Panel 与数据面通用约定）────────────────────────────────────────────
# 服务实例 id（hub 单实例部署固定 default）
TDAI_SERVICE_ID=default
# 用户 key（Panel「用户管理」发放，sk-mem- 开头；权限校验靠它，禁止共享）
TDAI_USER_KEY=sk-mem-REPLACE_ME

# ── Knowledge Service（KS，wiki 检索/读取直连）──────────────────────────────
# 注意：KS 端点只认 X-Tdai-Service-Id，不认用户身份——检索可直连，写操作一律走 Panel。
KS_BASE_URL=http://REPLACE_ME:8424/v3

# ── 本 skill 使用的 wiki 资源 id（Panel 建好资源后填）───────────────────────
# 正式规则库（页面全部 locked，仅审核 agent 可写）
WIKI_RULES_OFFICIAL=modeling-rules
# 草稿区（成员提交规则提案的待审队列）
WIKI_RULES_DRAFT=modeling-rules-draft

# ── MySQL（词根字典 + 字段翻译缓存 + 码值表 + 使用记录，多用户共享；CSV 仅为首次引导种子）──
# 表：md_word_roots / md_field_cache / md_root_usage / md_code_values / md_code_value_mappings
# 建表与 v2 存量迁移语句见 scripts/schema.sql
MYSQL_HOST=REPLACE_ME
MYSQL_PORT=3306
MYSQL_USER=REPLACE_ME
# 密码含 # 等特殊字符时必须加引号
MYSQL_PASS='REPLACE_ME'
MYSQL_DB=datadev_mast
MD_OPERATOR=你的账号

# ── 词根平台（DDM_*）【可选：仅“同步词根”时需要，可不填】─────────────────────
# roots.py sync 从这里拉词根。任何返回 {"totalItems": N, "content": [...]} 的服务都可接。
# 不配置不影响建模主流程。
DDM_API_URL=https://ddm.example.com/api/roots
DDM_PORTAL_URL=https://ddm.example.com
DDM_USERNAME=你的词根平台账号
# 词根平台登录态 Cookie（浏览器登录后复制；含会话凭证，禁止提交 git）
DDM_COOKIE='REPLACE_ME'
# 自签证书环境（内网 CA）设为 0 关闭证书校验，默认 1 校验
DDM_VERIFY_SSL=1
